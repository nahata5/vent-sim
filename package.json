{
  "name": "vent-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-hosted, physics-first mechanical-ventilator simulator for clinical education.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "batch": "tsx scripts/batch.ts",
    "docs:authoring": "tsx scripts/authoring-doc.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "4.131.1"
  },
  "engines": {
    "node": ">=20"
  }
}
